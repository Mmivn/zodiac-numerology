# Zodiac & Numerology backend — AI provider configuration.
# Copy to backend/.env (if running `uvicorn main:app` from *inside*
# backend/) and fill in real values, or just reuse the repo-root .env
# (if running `uvicorn backend.main:app` from the repo root instead —
# ALL_API's Config.from_env() reads .env from the process's current
# working directory either way). Never commit a real .env.
#
# On Render/Railway/Vercel these are set as dashboard environment
# variables instead of a file — same names, same effect.
#
# Same variable names as the repo-root .env.example, read by ALL_API's
# Config.from_env() via ai_service.py (imported unmodified — see
# backend/main.py). Active fallback chain — free-first, OpenAI last
# resort:
#   Gemini -> Groq -> Mistral -> Cloudflare Workers AI -> OpenAI (paid, last resort)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=

# Cloudflare Workers AI needs BOTH of these.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ------------------------------------------------------------------------------
# Routing — pinned explicitly so the active chain and provider exclusions
# don't silently drift if ALL_API's own defaults ever change.
# ------------------------------------------------------------------------------
PROVIDER_ORDER=gemini,groq,mistral,cloudflare,openai
TRANSLATION_PROVIDER_ORDER=gemini,groq,mistral,cloudflare,openai

# ------------------------------------------------------------------------------
# Cost protection — gates OpenAI, the only paid provider in the active chain.
# ------------------------------------------------------------------------------
PAID_FALLBACK_ENABLED=true
DAILY_PAID_BUDGET_USD=2.00

# ------------------------------------------------------------------------------
# Backend-specific: comma-separated list of origins allowed to call this
# API (CORS). Include the Vercel production URL once deployed.
# ------------------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:3000
