# Copy to .env.local for local dev. Never put real secrets here — this
# frontend only ever talks to the FastAPI backend below, never a
# provider directly, so there is nothing secret to configure on this side.

# URL of the backend (see ../backend). Local dev default matches
# `uvicorn backend.main:app --port 8000` run from the repo root.
NEXT_PUBLIC_API_URL=http://localhost:8000
