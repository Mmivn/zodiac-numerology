# Zodiac & Numerology — AI provider configuration
# Copy this file to .env and fill in the keys you actually have.
# Never commit the real .env file (it is already in .gitignore).
#
# AI calls go through ALL_API's AIGateway (see ai_service.py), installed as
# a dependency straight from its own GitHub repo (see requirements.txt) —
# ALL_API never bundles credentials, and this project never duplicates its
# provider code.
#
# Active fallback chain — free-first, OpenAI last resort:
#   Gemini -> Groq -> Mistral -> Cloudflare Workers AI -> OpenAI (paid, last resort)
#
# OpenAI is only ever reached once Gemini, Groq, Mistral, and Cloudflare have
# all failed, rate-limited, or timed out — and even then only if
# PAID_FALLBACK_ENABLED and DAILY_PAID_BUDGET_USD allow it.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=

# Cloudflare Workers AI needs BOTH of these — a token alone won't work, since
# the account ID is part of the request URL, not a header.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Kept out of automatic routing by policy (see PROVIDER_ORDER below), but
# still read if set — a key here alone does not enable them.
#   Cerebras:   requires billing to be enabled on the account
#   OpenRouter: free-tier pool is not reliable enough for an automatic chain
#   DeepSeek:   requires a funded account
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# ------------------------------------------------------------------------------
# Model overrides — optional, sensible defaults ship in ALL_API/all_api/config.py.
# ------------------------------------------------------------------------------
GEMINI_MODEL=gemini-flash-latest
GROQ_MODEL=openai/gpt-oss-20b
MISTRAL_MODEL=mistral-small-latest
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
OPENAI_MODEL=gpt-4.1-mini

# ------------------------------------------------------------------------------
# Routing — explicitly pinned so this project's active chain and provider
# exclusions don't silently drift if ALL_API's own defaults ever change.
# ------------------------------------------------------------------------------
PROVIDER_ORDER=gemini,groq,mistral,cloudflare,openai
TRANSLATION_PROVIDER_ORDER=gemini,groq,mistral,cloudflare,openai

# ------------------------------------------------------------------------------
# Cost protection — gates OpenAI, the only paid provider in the active chain.
# ------------------------------------------------------------------------------
PAID_FALLBACK_ENABLED=true
DAILY_PAID_BUDGET_USD=2.00

# ------------------------------------------------------------------------------
# Networking & cache
# ------------------------------------------------------------------------------
REQUEST_TIMEOUT_SECONDS=20
MAX_RETRIES_PER_PROVIDER=1
CACHE_TTL_SECONDS=300
